<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.louisesfer.thesis.selfcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/louisesfer/Downloads/thesis/scripts/pipeline_selfcheck.sh</string>
    </array>

    <!-- Run every Sunday at 04:00 local time (Weekday 1=Sunday) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/louisesfer/Downloads/thesis/logs/launchd_selfcheck.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/louisesfer/Downloads/thesis/logs/launchd_selfcheck_err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/louisesfer/Downloads/thesis</string>
</dict>
</plist>
