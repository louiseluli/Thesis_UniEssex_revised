<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.louisesfer.thesis.collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/louisesfer/Downloads/thesis/scripts/collect_daily.sh</string>
    </array>

    <!-- Run daily at 03:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/louisesfer/Downloads/thesis/logs/launchd_collect.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/louisesfer/Downloads/thesis/logs/launchd_collect_err.log</string>

    <!-- Run immediately if missed (e.g. laptop was off) -->
    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/louisesfer/Downloads/thesis</string>
</dict>
</plist>
