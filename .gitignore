# OS
.DS_Store

# Claude Code local memory (never commit)
.claude/

# Python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Logs and local backups (generated; not version-controlled)
logs/
backups/
.git_prev_*
AlgoFairness-clean/

# Data — never commit the raw database (top-level data/ only)
/data/
*.parquet

# Heavy outputs
outputs/models/
outputs/interactive/
outputs/overview/
outputs/mitigation/
*.html
*.png
*.pdf
*.json

# Allow figures committed for GitHub README display
!outputs/figures/**/*.png
!outputs/figures/*.png

# Training artifacts
**/checkpoint-*/
*.safetensors
optimizer.pt
scheduler.pt
training_args.bin
rng_state.pth
trainer_state.json
events.out.tfevents.*

# Keep important source/config/text
!config/**
!theory/**
!dissertation/auto_tables/**
